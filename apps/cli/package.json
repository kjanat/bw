{
	"name": "@kjanat/vaultwarden-cli",
	"version": "0.1.1",
	"keywords": [
		"vaultwarden",
		"bitwarden",
		"password-manager",
		"cli",
		"dreamcli",
		"micro509"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/vw.git",
		"directory": "apps/cli"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/kjanat"
	},
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"imports": {
		"#pkg": "./package.json",
		"#test/*": "./test/*.ts",
		"#fixtures/*.json": "./test/fixtures/*.json",
		"#*": "./src/*.ts"
	},
	"exports": {
		".": "./dist/main.mjs",
		"./package.json": "./package.json"
	},
	"bin": {
		"vw": "./dist/main.mjs"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "bun src/main.ts",
		"lint": "eslint src test",
		"test": "bun test",
		"test:compat": "bun test/run-compatibility.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@kjanat/dreamcli": "catalog:",
		"@kjanat/vaultwarden": "workspace:*"
	},
	"devDependencies": {
		"@babel/eslint-parser": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@eslint/js": "catalog:",
		"@types/bun": "catalog:",
		"@vw/typescript-config": "workspace:*",
		"eslint": "catalog:",
		"fflate": "catalog:",
		"micro509": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.8.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
