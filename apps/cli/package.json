{
	"name": "@kjanat/vaultwarden-cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#test/*": "./test/*.ts",
		"#fixtures/*.json": "./test/fixtures/*.json",
		"#*": {
			"bun": "./src/*.ts",
			"types": "./src/*.ts",
			"default": "./dist/*.js"
		}
	},
	"bin": {
		"vw": "dist/main.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"dev": "bun src/main.ts",
		"lint": "eslint src test",
		"test": "bun test",
		"test:compat": "bun test/run-compatibility.ts"
	},
	"dependencies": {
		"@kjanat/dreamcli": "catalog:",
		"@kjanat/vaultwarden": "workspace:*"
	},
	"devDependencies": {
		"@babel/eslint-parser": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@eslint/js": "catalog:",
		"@types/bun": "catalog:",
		"@vw/typescript-config": "workspace:*",
		"eslint": "catalog:",
		"fflate": "catalog:",
		"micro509": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.8.0"
	}
}
