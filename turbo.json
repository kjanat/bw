{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**",
				"src/generated/**",
				"wasm/THIRD_PARTY_NOTICES.txt"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/mise.toml",
				"$TURBO_ROOT$/tools/**"
			],
			"env": [
				"RUSTUP_TOOLCHAIN",
				"RUSTFLAGS",
				"CARGO_ENCODED_RUSTFLAGS"
			],
			"passThroughEnv": [
				"CARGO_HOME",
				"RUSTUP_HOME"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"typecheck": {
			"dependsOn": [
				"build",
				"^typecheck"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test:compat": {
			"dependsOn": [
				"build"
			],
			"outputs": [],
			"cache": false,
			"env": [
				"VOLTA_HOME"
			]
		},
		"test": {
			"dependsOn": [
				"build"
			],
			"outputs": [],
			"cache": false,
			"env": [
				"VW_TEST_SERVER",
				"VW_TEST_BW",
				"VW_TEST_IMPORT_FORMAT",
				"VW_TEST_MAILPIT"
			]
		}
	}
}
