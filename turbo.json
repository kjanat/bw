{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^build", "^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test:compat": {
			"dependsOn": ["build"],
			"outputs": [],
			"cache": false,
			"env": [
				"VW_TEST_VERSION",
				"VW_TEST_IMAGE",
				"VW_TEST_BW",
				"VW_TEST_BW_VERSION",
				"VW_TEST_CASE",
				"VW_TEST_FOCUSED_IMPORT",
				"VW_TEST_PROTOCOL_ONLY",
				"VW_TEST_IMPORT_FORMAT",
				"VW_TEST_IMPORT_SHARD",
				"VW_TEST_SKIP_IMPORTS",
				"VW_TEST_LIST_FILTERS_ONLY",
				"VW_TEST_POLICY_REDACTION_ONLY",
				"VOLTA_HOME",
				"VW_TEST_SMTP",
				"VW_TEST_SSO"
			]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": [],
			"cache": false,
			"env": ["VW_TEST_SERVER", "VW_TEST_BW", "VW_TEST_IMPORT_FORMAT", "VW_TEST_MAILPIT"]
		}
	}
}
