{
	"name": "@kjanat/vaultwarden",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": {
			"bun": "./src/*.ts",
			"types": "./src/*.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"THIRD_PARTY_NOTICES.md",
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"lint": "eslint src test",
		"test": "bun test"
	},
	"dependencies": {
		"@noble/hashes": "catalog:",
		"@xmldom/xmldom": "catalog:",
		"fflate": "catalog:",
		"kdbxweb": "catalog:",
		"parse5": "catalog:",
		"tldts": "catalog:",
		"zxcvbn": "catalog:"
	},
	"devDependencies": {
		"@babel/eslint-parser": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@eslint/js": "catalog:",
		"@types/bun": "catalog:",
		"@types/zxcvbn": "catalog:",
		"@vw/typescript-config": "workspace:*",
		"eslint": "catalog:",
		"typescript": "catalog:"
	}
}
