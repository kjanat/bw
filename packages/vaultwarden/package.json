{
	"name": "@kjanat/vaultwarden",
	"version": "0.1.0",
	"keywords": [
		"vaultwarden",
		"bitwarden",
		"password-manager",
		"sdk",
		"dreamcli",
		"micro509"
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/kjanat"
	},
	"type": "module",
	"imports": {
		"#test/*": "./test/*.ts",
		"#*": "./src/*.ts"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./kdbx-worker": "./dist/kdbx-worker.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"lint": "eslint src test",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@xmldom/xmldom": "catalog:",
		"fflate": "catalog:",
		"kdbxweb": "catalog:",
		"lunr": "catalog:",
		"micro509": "catalog:",
		"parse5": "catalog:",
		"tldts": "catalog:",
		"zxcvbn": "catalog:"
	},
	"devDependencies": {
		"@babel/eslint-parser": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@eslint/js": "catalog:",
		"@types/bun": "catalog:",
		"@types/lunr": "catalog:",
		"@types/zxcvbn": "catalog:",
		"@vw/typescript-config": "workspace:*",
		"eslint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.8.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"inlinedDependencies": {
		"kdbxweb": "2.1.1"
	}
}
