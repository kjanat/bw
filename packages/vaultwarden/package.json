{
	"name": "@kjanat/vaultwarden",
	"version": "0.1.2",
	"keywords": [
		"vaultwarden",
		"bitwarden",
		"password-manager",
		"sdk",
		"dreamcli",
		"micro509"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/vw.git",
		"directory": "packages/vaultwarden"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/kjanat"
	},
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"imports": {
		"#pkg": "./package.json",
		"#test/*": "./test/*.ts",
		"#*": "./src/*.ts"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./kdbx-worker": "./dist/kdbx-worker.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"dist"
	],
	"scripts": {
		"build": "bun run build:wasm && tsdown",
		"build:wasm": "bun ../../tools/repo.ts wasm build",
		"lint": "eslint src test wasm/build.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@xmldom/xmldom": "catalog:",
		"fflate": "catalog:",
		"lunr": "catalog:",
		"micro509": "catalog:",
		"parse5": "catalog:",
		"tldts": "catalog:"
	},
	"devDependencies": {
		"@babel/eslint-parser": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@bytecodealliance/jco": "1.40.0",
		"@eslint/js": "catalog:",
		"@types/bun": "catalog:",
		"@types/lunr": "catalog:",
		"@vw/typescript-config": "workspace:*",
		"eslint": "catalog:",
		"kdbxweb": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.8.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"inlinedDependencies": {
		"kdbxweb": "2.1.1"
	}
}
