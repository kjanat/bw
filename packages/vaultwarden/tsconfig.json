{
	"extends": "@vw/typescript-config/base.json",
	"compilerOptions": {
		"types": [
			"bun"
		],
		"rootDir": ".",
		"declarationMap": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"wasm/build.ts",
		"build-plugins/**/*.ts"
	]
}
