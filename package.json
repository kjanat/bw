{
	"name": "vw",
	"private": true,
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "dprint fmt",
		"lint": "turbo run lint",
		"pkg-pr-new": "pkg-pr-new publish --bun --packageManager=bun --commentWithSha --json artifacts/preview.json './.cache/pkg-pr-new/*'",
		"repo": "bun tools/repo.ts",
		"test": "bun run test:repo && turbo run test",
		"test:compat": "turbo run test:compat",
		"test:repo": "bun test tools",
		"typecheck": "bun run typecheck:repo && turbo run typecheck",
		"typecheck:repo": "tsc --noEmit -p tools/tsconfig.json"
	},
	"overrides": {
		"@xmldom/xmldom": "catalog:"
	},
	"devDependencies": {
		"@kjanat/dreamcli": "catalog:",
		"@types/bun": "catalog:",
		"baseline-browser-mapping": "^2.11.34",
		"esbuild": "0.28.2",
		"pkg-pr-new": "0.0.92",
		"turbo": "^2.11.10",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.8.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4",
			"onFail": "warn"
		}
	},
	"catalog": {
		"@babel/eslint-parser": "8.0.7",
		"@babel/preset-typescript": "8.0.7",
		"@eslint/js": "10.0.1",
		"@kjanat/dreamcli": "5.0.0",
		"@types/bun": "^1.4.4",
		"@types/lunr": "2.3.7",
		"@xmldom/xmldom": "0.9.12",
		"eslint": "10.13.0",
		"fflate": "0.8.3",
		"kdbxweb": "2.1.1",
		"lunr": "2.3.9",
		"micro509": "0.17.1",
		"parse5": "8.0.1",
		"tldts": "7.4.19",
		"tsdown": "^0.23.3",
		"typescript": "7.0.2"
	},
	"patchedDependencies": {
		"kdbxweb@2.1.1": "patches/kdbxweb@2.1.1.patch"
	}
}
